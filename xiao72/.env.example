# 小72 配置模板 —— 复制本文件为 .env 后填入真实值
# 不要把 .env 提交到 git，也不要贴到聊天窗口里

# 服务商：deepseek / qwen / moonshot / openai / ollama
X72_PROVIDER=deepseek

# API Key（必填）。DeepSeek 的 key 形如 sk-xxxxxxxxxxxxxxxx
X72_API_KEY=

# 可选：覆盖默认地址和模型（一般不用改）
# X72_BASE_URL=https://api.deepseek.com
# X72_MODEL=deepseek-chat

# 可选：调用超时（秒）与温度（意图识别建议 0~0.2）
# X72_TIMEOUT=20
# X72_TEMPERATURE=0.1

# ---------------------------------------------------------------
# 本机环境（换设备只改这一段，代码和 .bat 里没有任何绝对路径）
# ---------------------------------------------------------------

# 串口。不填会自动找 CH340 / 第一个 USB 串口
# X72_PORT=COM13

# 解释器。不填会依次尝试 ~/xiao72-venv、仓库内 .venv、当前解释器
# X72_PYTHON=C:\Users\你\xiao72-venv\Scripts\python.exe

# Whisper 模型缓存目录。不填默认 %LOCALAPPDATA%\xiao72\models
# X72_MODEL_DIR=C:\Users\你\AppData\Local\xiao72\models

# 下载模型用的代理。不填则沿用系统已有的 HTTPS_PROXY
# X72_PROXY=http://127.0.0.1:7897

# Silero VAD 模型路径。不填默认 %LOCALAPPDATA%\xiao72\models\silero_vad.onnx
# 下载：https://github.com/snakers4/silero-vad/raw/master/src/silero_vad/data/silero_vad.onnx
# X72_VAD_MODEL=C:\Users\你\AppData\Local\xiao72\models\silero_vad.onnx

# ---------------------------------------------------------------
# 语音播报（TTS）——换音色只改这里，不动代码
# ---------------------------------------------------------------

# 引擎：edge（微软在线，自然）/ sapi（Windows 离线，机械）/ none
# X72_TTS_ENGINE=edge

# 音色。常用中文：
#   zh-CN-XiaoxiaoNeural  女声，温柔自然（默认）
#   zh-CN-XiaoyiNeural    女声，活泼
#   zh-CN-YunxiNeural     男声，年轻
#   zh-CN-YunyangNeural   男声，播音腔
# X72_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 语速 / 音量，百分比形式
# X72_TTS_RATE=+0%
# X72_TTS_VOLUME=+0%

# 静音播报：1 = 只显示文字不出声
# X72_TTS_MUTE=0
